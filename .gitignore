# ============================================================
# Dose Whisperer .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets and keys (never commit) ---
.env
.env.*
*.key
*.pem
.streamlit/secrets.toml
secrets.json
credentials.json

# --- Jupyter / Colab ---
.ipynb_checkpoints/

# --- Data (MIMIC-III Demo, processed sets, openFDA cache) ---
data/
dataset/
mimic/
*.csv.gz
openfda_cache/
cache/
.cache/

# Allow small, intentional data files, e.g. the curated drug/condition list
!configs/**
!reference/*.csv
!reference/*.json

# --- Model weights, adapters, and training output ---
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
checkpoints/
adapters/
lora_output/
qlora_output/
runs/
wandb/
mlruns/
huggingface/
models/

# --- Logs and temporary files ---
*.log
tmp/
temp/

# --- Testing and tooling ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editor and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# --- Intentionally tracked ---
# reports/ (evaluation_report.md, results.json, metrics.csv, charts)
# configs/  (selected model configuration)
# notebooks/ and app/
